DB_HOST=your-postgres-host
DB_NAME=wiseape-application-system
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_PORT=5432
PORT=4000

# Seeds the initial admin account on first boot (see src/models/authModel.js).
# Only used if that admin row doesn't already exist -- change this after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
